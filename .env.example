# --- База данных ---
POSTGRES_USER=ryadom
POSTGRES_PASSWORD=change-me-local
POSTGRES_DB=ryadom

# --- Backend ---
# Длинная случайная строка. Сгенерировать: openssl rand -hex 32
JWT_SECRET=dev-secret-change-me-please-32-chars-min

# Через запятую, без слэша в конце.
# Локально:
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
# На проде:
# CORS_ORIGINS=https://xn--80acgsbramf8bn.xn--p1ai,https://www.xn--80acgsbramf8bn.xn--p1ai

# --- Учётка психолога, синхронизируется с .env при каждом старте ---
# Пароль минимум 8 символов, иначе учётка не создастся.
OPERATOR_LOGIN=psy
OPERATOR_PASSWORD=change-me-please
OPERATOR_NAME=Аня

# --- Хранение ---
# Диалоги без сообщений дольше этого срока удаляются автоматически.
# 0 отключает очистку — в проде так лучше не делать.
CONVERSATION_TTL_DAYS=90

# --- Только для docker-compose.prod.yml ---
# антибуллинг.рф в punycode. Caddy получит сертификат на оба адреса.
SITE_ADDRESS=xn--80acgsbramf8bn.xn--p1ai, www.xn--80acgsbramf8bn.xn--p1ai
ACME_EMAIL=admin@example.com
